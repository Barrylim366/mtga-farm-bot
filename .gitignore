# Ignore generated card data
cards.json
cards_metadata.json
nul
NUL
# Build artifacts
build/
dist/
dist_nuitka/
__pycache__/
*.pyc
*.pyo
*.pyd

# Local environment
.venv/
# macOS launcher venv (+ its timestamped backups) live inside the repo folder
.venv-macos*/
*.log
runtime/

# Accounts are user-specific — keep folder structure but ignore contents
Accounts/*
!Accounts/.gitkeep

# IDE and local tooling
.idea/
# Local Claude Code state (settings, locks) stays out, but the skills are
# project documentation -- they describe how to operate this bot, not machine
# state -- so they are tracked.
.claude/*
!.claude/skills/

# Internal AI/session files
learning.md
# AGENTS.md is deliberately NOT ignored: like .claude/skills/ it is project
# documentation describing how to work on this bot, and it is tracked.


